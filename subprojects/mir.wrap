# MIR: the JIT substrate (codegen + interpreter) that libslimcc emits modules
# for. Pinned here at the top level so it takes precedence over slimcc's own
# bundled mir.wrap (nested wrap resolution), keeping both on the same fork.
#
# Pinned to a commit on the fork's debug-support branch (its aggregate branch:
# meson subproject support + the source-level debug extensions), so a release
# builds reproducibly. To move it: push to the fork, update the SHA here, then
# `meson subprojects update --reset mir` (or temporarily repoint the url at a
# local checkout for iteration).
[wrap-git]
url = https://github.com/cyanogilvie/mir.git
revision = 625be9104f98108eff794a54a48fff7022ff04b2
depth = 1

[provide]
mir = mir_dep
