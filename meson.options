option('testmode', type: 'boolean', value: false,
  description: 'Build with whitebox testing hooks exposed')

option('stubsmode', type: 'boolean', value: false,
  description: 'Link the jit code with Tcl via stubs')

option('benchmark', type: 'feature', value: 'disabled',
  description: 'Enable benchmarks (auto: enable if all deps are found)')

option('sys_includes', type: 'array', value: [],
  description: 'System <...> include dirs for JIT compiles on the target host (default: the build compiler\'s search list)')
