if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest
    namespace import ::tcltest::*
}

::tcltest::loadTestedCommands
package require jitc

package require jitclib::json

if {[info commands readFile] eq ""} {	;# Tcl 8.6
	proc readFile fn {set h [open $fn r]; try {read $h} finally {close $h}}
}

test jitclib_json-1.1 {check a small doc} -body { #<<<
	jitc::capply $::jitclib::json_check check { {"foo": "bar", "baz": [1, 2, 3]}}
} -result 1
#>>>
test jitclib_json-2.1 {validate a small doc} -body { #<<<
	jitc::capply $::jitclib::json valid { {"foo": "bar", "baz": [1, 2, 3]}}
} -result 1
#>>>

if {[file readable /tmp/items9.json]} {
test jitclib_json-1.2 {check a large doc} -body { #<<<
	jitc::capply $::jitclib::json_check check [readFile /tmp/items9.json]
} -result 1
#>>>
test jitclib_json-2.2 {validate a large doc} -body { #<<<
	jitc::capply $::jitclib::json valid [readFile /tmp/items9.json]
} -result 1
#>>>
}

test jitclib_json-1.3 {check a small doc} -body { #<<<
	jitc::capply $::jitclib::json_check check {"”"}
} -result 1
#>>>
test jitclib_json-2.3 {validate a small doc} -body { #<<<
	jitc::capply $::jitclib::json valid {"”"}
} -result 1
#>>>


# cleanup
::tcltest::cleanupTests
return

# vim: ft=tcl foldmethod=marker foldmarker=<<<,>>> ts=4 shiftwidth=4
