if {[lsearch [namespace children] ::tcltest] == -1} {
    package require tcltest
    namespace import ::tcltest::*
}

::tcltest::loadTestedCommands
package require jitc

# Aggregates passed and returned by value between cdef code and host-compiled
# code follow the host ABI. libslimcc's scripts/test_mir_abi.sh covers the
# shapes exhaustively; these pin the cases that reach jitc users.

test abi-1.1 {small struct returned by value from a host function (libc div)} -body { #<<<
	jitc::capply {
		code { //@begin=c@
			#include <stdlib.h>
			OBJCMD(test) {
				div_t	r = div(7, 2);
				Tcl_SetObjResult(interp, Tcl_ObjPrintf("%d %d", r.quot, r.rem));
				return TCL_OK;
			}
			//@end=c@
		}
	} test
} -result {3 1}
#>>>
test abi-1.2 {16-byte struct returned by value from a host function (libc lldiv)} -body { #<<<
	jitc::capply {
		code { //@begin=c@
			#include <stdlib.h>
			OBJCMD(test) {
				lldiv_t	r = lldiv(1000000000007LL, 10LL);
				Tcl_SetObjResult(interp, Tcl_ObjPrintf("%lld %lld", r.quot, r.rem));
				return TCL_OK;
			}
			//@end=c@
		}
	} test
} -result {100000000000 7}
#>>>
test abi-1.3 {struct result in a loop condition (the libaspell next_misspelling shape)} -body { #<<<
	jitc::capply {
		code { //@begin=c@
			#include <stdlib.h>
			OBJCMD(test) {
				Tcl_Obj*	res = Tcl_NewListObj(0, NULL);
				div_t		r;
				int			n = 100, guard = 0;
				// guard: a garbage div_t mustn't loop forever
				while ((r = div(n, 3)).quot && guard++ < 10) {
					Tcl_ListObjAppendElement(interp, res, Tcl_NewIntObj(r.rem));
					n = r.quot;
				}
				Tcl_SetObjResult(interp, res);
				return TCL_OK;
			}
			//@end=c@
		}
	} test
} -result {1 0 2 0}
#>>>
test abi-2.1 {structs returned by value from cdef functions, called through function pointers} -body { #<<<
	jitc::capply {
		code { //@begin=c@
			#include <stdlib.h>
			typedef struct { int a, b; } pair;
			typedef struct { double x, y; } point;
			static pair mkpair(int a) { return (pair){a, a * 2}; }
			static point mkpoint(double x) { return (point){x, x / 2}; }
			OBJCMD(test) {
				// volatile: call through a pointer the compiler can't see through
				pair	(*volatile fp)(int) = mkpair;
				point	(*volatile gp)(double) = mkpoint;
				pair	p = fp(21);
				point	q = gp(3.0);
				Tcl_SetObjResult(interp, Tcl_ObjPrintf("%d %d %g %g", p.a, p.b, q.x, q.y));
				return TCL_OK;
			}
			//@end=c@
		}
	} test
} -result {21 42 3 1.5}
#>>>

::tcltest::cleanupTests
return

# vim: ft=tcl foldmethod=marker foldmarker=<<<,>>> ts=4 shiftwidth=4
