proc readfile fn {
	set h	[open $fn]
	try {read $h} finally {close $h}
}

bench jitc_json-1.1 {test a json doc for validity} -setup { #<<<
	package require jitclib::json
	package require rl_json
	set a	{ {"foo": "bar", "baz": [1, 2, 3]}}
	set b	{ {"foo": "bar", "baz": [1, 2, 3,]}}
	set v	[list {*}$::jitclib::json options -O2]
	set c	[list {*}$::jitclib::json_check options -O2]
} -compare {
	jitclib_json_valid	{
		list \
			[jitc::capply $v valid $a] \
			[jitc::capply $v valid $b]
	}
	jitclib_json_check	{
		list \
			[jitc::capply $c check $a] \
			[jitc::capply $c check $b]
	}
	rl_json_valid	{
		list \
			[rl_json::json valid $a] \
			[rl_json::json valid $b]
	}
	rl_json_keys	{
		list \
			[expr {![catch {
				rl_json::json keys $a
			}]}] \
			[expr {![catch {
				rl_json::json keys $b
			}]}]
	}
} -cleanup {
	unset -nocomplain a b v c
} -result {1 0}
#>>>
if {[file exists /tmp/items9.json]} {
bench jitc_json-2.1 {validate a large JSON doc} -setup { #<<<
	package require jitclib::json
	package require rl_json
	set doc	[readfile /tmp/items9.json]
	set v	[list {*}$::jitclib::json options -O2]
	set c	[list {*}$::jitclib::json_check options -O2]
} -compare {
	jitclib_json_check	{
		jitc::capply $c check $doc
	}
	jitclib_json_valid	{
		jitc::capply $v valid $doc
	}
	rl_json_valid	{
		rl_json::json valid $doc
	}
	rl_json_type	{
		expr {![catch {
			rl_json::json type $doc
		}]}
	}
} -cleanup {
	unset -nocomplain doc c v
} -result 1
#>>>
}

